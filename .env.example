# ---------------------------------------------------------------------------
# PORTWATCH — Termini Imerese
# In locale: copiare in `.env.local` (mai committare il file reale).
# In produzione: impostare gli stessi nomi nei secret del sito (Sites → Secrets).
# ---------------------------------------------------------------------------

# Endpoint REST aiscast (Open Waters AIS). Non richiede credenziali:
# lasciare vuoto per usare https://ais.openwaters.io/v1/vessels
# AISCAST_REST_URL=

# --- Notifiche email (Brevo, API HTTP) --------------------------------------
# Piano gratuito: 300 email/giorno. Creare la chiave su
# https://app.brevo.com/settings/keys/api e verificare il mittente in
# Senders & Domains (basta un indirizzo email, nessun dominio richiesto).
EMAIL_API_KEY=

# Mittente verificato su Brevo. Se vuoto viene usato il primo destinatario.
# EMAIL_FROM=noreply@example.com

# Destinatari creati al primo avvio (separati da virgola).
# Possono essere gestiti anche dalla pagina Impostazioni.
# NOTIFY_EMAILS=operatore@example.com

# --- Accesso (Sign in with Freebuff) ---
# Su Sites queste tre variabili le inietta il deploy; in sviluppo servono i
# valori dell'ambiente "development" restituiti da sites_enable_auth.
# FREEBUFF_CLIENT_ID=
# FREEBUFF_ISSUER=https://freebuff.com/oidc
# APP_ORIGIN=https://<dominio-del-sito>
